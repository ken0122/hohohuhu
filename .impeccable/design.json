      "html": "<button class=\"ds-send\" aria-label=\"发送消息\"><svg viewBox=\"0 0 20 20\" aria-hidden=\"true\"><path d=\"m4 10 11-6-3.1 12-2.6-4.2L4 10Z\"/><path d=\"m9.3 11.8 2.4-2.3\"/></svg></button>",
